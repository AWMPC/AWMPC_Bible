# Public Firebase Web SDK configuration. Copy to .env.local and replace locally.
VITE_FIREBASE_API_KEY=replace-locally
VITE_FIREBASE_AUTH_DOMAIN=replace-locally
VITE_FIREBASE_PROJECT_ID=replace-locally
VITE_FIREBASE_APP_ID=replace-locally
# Optional public R2 origin containing bibles.json and bible-*.json objects.
VITE_BIBLE_DATA_BASE_URL=replace-locally
