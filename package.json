{
  "name": "awmpc-bible",
  "version": "0.31.47",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "stage:data": "node scripts/stageDatasets.mjs",
    "dev": "vite",
    "dev:test": "vite",
    "prebuild": "npm run stage:data",
    "build": "tsc --noEmit && vite build",
    "build:code": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "^8.1.4"
  },
  "type": "module"
}
